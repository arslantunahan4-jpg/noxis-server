# Server Configuration
PORT=3000
NODE_ENV=production

# MongoDB Connection String
# Replace with your actual connection string from MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority

# TMDB API Key (REQUIRED)
# Get your key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Real-Debrid Token (Optional)
REAL_DEBRID_TOKEN=your_real_debrid_token_here

# FFmpeg Paths (Optional - defaults to system paths)
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# API URL for frontend
VITE_API_URL=https://your-domain.com

# Telegram Storage (Optional)
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHANNEL_ID=your_channel_id

# LiveKit (Voice Chat) (Optional)
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# Admin Setup Secret (Optional - for first-time admin setup)
ADMIN_SETUP_SECRET=your_secure_random_string_here
