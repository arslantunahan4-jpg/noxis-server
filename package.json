{
  "name": "noxis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --port 5000 --host",
    "dev:full": "start node server.js && vite --port 5000 --host",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "start:railway": "node server-railway.js",
    "restore": "./restore-full-version.sh",
    "electron:dev": "node electron/dev-runner.cjs",
    "electron:build": "npm run build && electron-builder --win",
    "electron:pack": "npm run build && electron-builder --win --dir",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "cap:build:release": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "test:e2e": "playwright test"
  },
  "build": {
    "appId": "com.noxis.player",
    "productName": "Noxis Player",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns",
      "category": "public.app-category.video"
    },
    "win": {
      "signAndEditExecutable": false,
      "icon": "public/icons/noxis.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "dmg": {
      "title": "Noxis Player",
      "backgroundColor": "#000000"
    }
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/core": "^7.6.8",
    "@capgo/cli": "^7.41.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@livekit/components-react": "^2.9.19",
    "@livekit/components-styles": "^1.2.0",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@mui/x-data-grid": "^8.25.0",
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/geo": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@supabase/supabase-js": "^2.89.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.1.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "formik": "^2.4.9",
    "framer-motion": "^11.18.2",
    "helmet": "^8.1.0",
    "hls.js": "^1.6.15",
    "html-to-image": "^1.11.13",
    "http-proxy-middleware": "^3.0.5",
    "input": "^1.0.1",
    "livekit-client": "^2.17.0",
    "livekit-server-sdk": "^2.15.0",
    "lodash.throttle": "^4.1.1",
    "lru-cache": "^11.2.4",
    "mongoose": "^8.0.0",
    "opensubtitles-api": "^5.1.2",
    "puppeteer": "^24.35.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.1.0",
    "react-pro-sidebar": "^1.1.0",
    "react-router-dom": "^6.30.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "socks-proxy-agent": "^8.0.2",
    "telegram": "^2.26.22",
    "winston": "^3.19.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@playwright/test": "^1.58.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "terser": "^5.46.0",
    "vite": "^5.4.21"
  }
}
